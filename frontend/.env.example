# Frontend environment.
#
# Copy to `.env.local` and adjust. Every value has a working default, so the app
# runs with this file absent.

# Base URL of the FastAPI backend.
# Leave as the empty-relative default to route through the Next.js rewrite
# proxy in next.config.mjs (single origin, no CORS preflight).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Where the rewrite proxy forwards /api/* to. Ignored when API_PROXY=false.
BACKEND_ORIGIN=http://localhost:8000
# API_PROXY=false

# Basemap style URL for the map (MapLibre GL JS).
#
# Leave unset to use the built-in default: OpenFreeMap's "liberty" style over
# OpenStreetMap data. No access token and no vendor account are required.
#
# Must be an https style URL that MapLibre can load. `mapbox://…` values are
# rejected because MapLibre has no code path for that scheme — it would need a
# Mapbox token, which this platform does not use. If the style host cannot be
# reached the map falls back to OpenStreetMap raster tiles and says so in the
# UI rather than failing.
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty