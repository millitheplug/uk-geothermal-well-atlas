# Backend configuration.
#
# Copy to `backend/.env` and adjust. Every value has a working default, so the
# backend starts with this file absent.
#
# The defaults are chosen so that `uvicorn app.main:app --reload` works from the
# `backend/` directory on a machine with no PostgreSQL, no Redis and no API key.

# ---- Application -------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_VERSION=0.1.0

# ---- Database ----------------------------------------------------------
# PostgreSQL + PostGIS is the production target. The SQLite fallback exists so
# the geospatial layer can be exercised without a PostGIS server; the distance
# expressions switch at the SQLAlchemy dialect level and every response reports
# which backend produced it as `spatial_dialect`.
#
#   SQLite:    sqlite:///./geothermal.db
#   PostGIS:   postgresql+psycopg://postgres:postgres@localhost:5432/ukgeothermal
DATABASE_URL=sqlite:///./geothermal.db
SQL_ECHO=false

# ---- Redis -------------------------------------------------------------
# Rate limiting and caching. Optional: the rate limiter falls back to an
# in-process counter when Redis is unreachable, which is correct for a single
# worker and wrong for several - set REDIS_URL if you run more than one.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ---- Security ----------------------------------------------------------
# CHANGE THIS. A default secret in a checked-in file is how a deployment ends up
# signing tokens anybody can forge. The application refuses to start in
# APP_ENV=production with the development secret.
SECRET_KEY=dev-only-change-me-in-production-please-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- AI ----------------------------------------------------------------
# With no key, the agent layer uses a deterministic mock provider that returns
# schema-valid structured output. Results are identical because no agent
# performs a calculation - only the prose differs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_ENABLED=true
AI_MAX_TOKENS=4096
# Zero. An agent that varies between runs cannot be used to review a decision.
AI_TEMPERATURE=0.0

# ---- Object storage ----------------------------------------------------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ukgeothermal
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# ---- Domain defaults ---------------------------------------------------
# Assumption set applied when a user supplies no override. These are
# assumptions, never facts, and every result reports them as such.
DEFAULT_PROJECT_LIFETIME_YEARS=20
DEFAULT_ELECTRICITY_PRICE_P_PER_KWH=15.0
DEFAULT_HEAT_PRICE_P_PER_KWH=8.5
DEFAULT_DISCOUNT_RATE=0.08